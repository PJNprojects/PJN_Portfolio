# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
# The site works without these: the brief builder falls back to opening the visitor's mail app,
# and /portal shows a "coming soon" note until the backend is connected.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
